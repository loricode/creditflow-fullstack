# Copia este archivo a .env (no se versiona)

# Contraseña del usuario de aplicación de Oracle. Terraform la guarda en Secrets Manager.
DB_PASSWORD=crediflow
ORACLE_ADMIN_PASSWORD=CrediflowAdmin1

# Opcional: clave de la API de Claude. Vacía = explicaciones por reglas.
# Terraform la guarda en el secreto crediflow/ia; el worker la lee al arrancar.
ANTHROPIC_API_KEY=

# Probabilidad de que el core bancario simulado falle (para ver reintentos y DLQ)
CORE_TASA_FALLO=0.2

# Puertos del host (cámbialos si chocan con otros proyectos)
ORACLE_PORT=1522
LOCALSTACK_PORT=4576
API_PORT=8088
CORE_PORT=8090
FRONTEND_PORT=3100
